# Raw and intermediate data are re-fetchable; only the manifest is version-controlled.
data/raw/*
!data/raw/manifest.json
data/interim/*
!data/interim/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.DS_Store

# Every dataset is committed in both CSV and Parquet so the repo is usable without
# running the pipeline. Nothing under data/processed is ignored.
